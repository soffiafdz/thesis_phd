	doi = {10.1016/B978-0-12-804733-0.00006-8},
	abstract = {Chapter 6 is generally concerned with issues related to multivariate data. The chapter begins with basic techniques for measuring the overall dispersion of a data cloud and how to measure the extent a particular point is nested within the cloud. These methods have practical value when testing hypotheses. Next, robust multivariate measures of location and scatter are introduced, followed by multivariate outlier detection techniques. Included are recent results related to situations where the number of variables is large. Confidence regions for robust multivariate measures of location, which take into account the overall structure of the data when dealing with outliers, are described. Inferential methods in the one-sample case are described, including an extension of Hotelling's method to trimmed means. Multivariate extensions of the Wilcoxon–Mann–Whitney test are covered, one of which is based on a projection of the data that helps characterize the extent two groups differ. The notion of data depth can be used to compare groups, which is based in part on a multivariate notion of ranks. This is followed by methods for comparing dependent groups. The chapter concludes with recent advances relevant to robust principal components, multivariate discriminate analysis, as well as some recent results related to functional data. R functions are described and illustrated.},
	urldate = {2025-03-13},
	booktitle = {Introduction to {Robust} {Estimation} and {Hypothesis} {Testing} ({Fourth} {Edition})},
	publisher = {Academic Press},
	author = {Wilcox, Rand},
