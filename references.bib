	month = jan,
	year = {2017},
	keywords = {Bootstrap methods, Comparing multivariate distributions, Data depth, Discriminate analysis, Functional data, Multivariate measures of location and scale, Multivariate outliers, Multivariate rank-based methods, Robust principal components},
	pages = {235--318},
	file = {PDF:/Users/soffiafdz/Zotero/storage/7QPW8EM5/Wilcox - 2017 - Chapter 6 - Some Multivariate Methods.pdf:application/pdf},
}

