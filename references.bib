	pages = {e211--e221},
	file = {ScienceDirect Full Text PDF:/Users/soffiafdz/Zotero/storage/JQ8TWTYB/Ge et al. - 2024 - Normative modelling of brain morphometry across the lifespan with CentileBrain algorithm benchmarki.pdf:application/pdf;ScienceDirect Snapshot:/Users/soffiafdz/Zotero/storage/QZ9WRIYJ/S2589750023002509.html:text/html},
