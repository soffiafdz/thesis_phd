}

@article{tremblay2021open,
	title = {Open science datasets from {PREVENT}-{AD}, a longitudinal cohort of pre-symptomatic {Alzheimer}'s disease},
	volume = {31},
	issn = {2213-1582},
	doi = {10.1016/j.nicl.2021.102733},
	abstract = {To move Alzheimer Disease (AD) research forward it is essential to collect data from large cohorts, but also make such data available to the global research community. We describe the creation of an open science dataset from the PREVENT-AD (PResymptomatic EValuation of Experimental or Novel Treatments for AD) cohort, composed of cognitively unimpaired older individuals with a parental or multiple-sibling history of AD. From 2011 to 2017, 386 participants were enrolled (mean age 63 years old ± 5) for sustained investigation among whom 349 have retrospectively agreed to share their data openly. Repositories are findable through the unified interface of the Canadian Open Neuroscience Platform and contain up to five years of longitudinal imaging data, cerebral fluid biochemistry, neurosensory capacities, cognitive, genetic, and medical information. Imaging data can be accessed openly at https://openpreventad.loris.ca while most of the other information, sensitive by nature, is accessible by qualified researchers at https://registeredpreventad.loris.ca. In addition to being a living resource for continued data acquisition, PREVENT-AD offers opportunities to facilitate understanding of AD pathogenesis.},
	language = {eng},
	journal = {NeuroImage. Clinical},
	author = {Tremblay-Mercier, Jennifer and Madjar, Cécile and Das, Samir and Pichet Binette, Alexa and Dyke, Stephanie O. M. and Étienne, Pierre and Lafaille-Magnan, Marie-Elyse and Remz, Jordana and Bellec, Pierre and Louis Collins, D. and Natasha Rajah, M. and Bohbot, Veronique and Leoutsakos, Jeannie-Marie and Iturria-Medina, Yasser and Kat, Justin and Hoge, Richard D. and Gauthier, Serge and Tardif, Christine L. and Mallar Chakravarty, M. and Poline, Jean-Baptiste and Rosa-Neto, Pedro and Evans, Alan C. and Villeneuve, Sylvia and Poirier, Judes and Breitner, John C. S. and {PREVENT-AD Research Group}},
	year = {2021},
	keywords = {Biomarkers, Alzheimer Disease, Humans, Middle Aged, Retrospective Studies, Neuroimaging, Amyloid beta-Peptides, Canada, Cerebrospinal Fluid proteins, Observational cohort, Open Science, Pre-symptomatic Alzheimer Disease, tau Proteins},
	pages = {102733},
