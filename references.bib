	keywords = {Approximate confidence intervals, Nonparametric intervals, Resampling methods, Second-order theory, Skewness corrections, Transformations},
	pages = {171--185},
	file = {Efron_1987_Better Bootstrap Confidence Intervals.pdf:/Users/soffiafdz/Zotero/storage/EPF424CH/Efron_1987_Better Bootstrap Confidence Intervals.pdf:application/pdf},
}

