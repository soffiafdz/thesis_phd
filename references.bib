@article{sanfilipo_correction_2004,
	title = {Correction for intracranial volume in analysis of whole brain atrophy in multiple sclerosis: the proportion vs. residual method},
	volume = {22},
	issn = {1053-8119},
	shorttitle = {Correction for intracranial volume in analysis of whole brain atrophy in multiple sclerosis},
	url = {https://www.sciencedirect.com/science/article/pii/S1053811904001934},
	doi = {10.1016/j.neuroimage.2004.03.037},
	abstract = {Two techniques that correct (normalize) regional and whole brain volumes according to head size—the proportion method (tissue-to-intracranial volume ratio) and the residual method (regression-based predicted brain tissue volumes)—are used pervasively in neuroimaging research, but have received little critical evaluation or direct comparison. Using a quantitatively derived MRI data set of patients with multiple sclerosis (n = 18) and age-/sex-matched normal controls (n = 18), we introduced various types of error into estimates of intracranial volume (ICV) and absolute parenchymal volume (APV) to observe how this error affected the final outcome of normalized brain measures and their ability to detect group differences, as computed by a proportion (brain parenchymal fraction [BPF]) and residual method (predicted parenchymal volume [PPV]). The results indicated that systemic error in ICV and APV values considerably affected BPF means based on the proportion method, except with dependent-related systematic APV error, but essentially did not change statistical power associated with group differences in BPF. Random error altered BPF means to a much smaller extent, but was associated with moderate reductions in statistical power. On the other hand, PPV estimates based on the residual method were unaffected by these same ICV and APV errors, except with dependent-related systematic APV error, and were not associated with reductions in statistical power. Our findings suggest that head size correction of brain regions with the residual method generally may provide advantages over the proportion method.},
	number = {4},
	urldate = {2026-01-29},
	journal = {NeuroImage},
	author = {Sanfilipo, Michael P and Benedict, Ralph H. B and Zivadinov, Robert and Bakshi, Rohit},
	month = aug,
	year = {2004},
	keywords = {MRI, Brain atrophy, Head size correction, Multiple sclerosis, Statistical parametric mapping},
	pages = {1732--1743},
	file = {ScienceDirect Full Text PDF:/Users/soffiafdz/Zotero/storage/JLKX2BQ2/Sanfilipo et al. - 2004 - Correction for intracranial volume in analysis of whole brain atrophy in multiple sclerosis the pro.pdf:application/pdf;ScienceDirect Snapshot:/Users/soffiafdz/Zotero/storage/ZPWKSUMZ/S1053811904001934.html:text/html},
}

@article{schmaal_subcortical_2016,
	title = {Subcortical brain alterations in major depressive disorder: findings from the {ENIGMA} {Major} {Depressive} {Disorder} working group},
	volume = {21},
	copyright = {2016 The Author(s)},
	issn = {1476-5578},
	shorttitle = {Subcortical brain alterations in major depressive disorder},
	url = {https://www.nature.com/articles/mp201569},
	doi = {10.1038/mp.2015.69},
	abstract = {The pattern of structural brain alterations associated with major depressive disorder (MDD) remains unresolved. This is in part due to small sample sizes of neuroimaging studies resulting in limited statistical power, disease heterogeneity and the complex interactions between clinical characteristics and brain morphology. To address this, we meta-analyzed three-dimensional brain magnetic resonance imaging data from 1728 MDD patients and 7199 controls from 15 research samples worldwide, to identify subcortical brain volumes that robustly discriminate MDD patients from healthy controls. Relative to controls, patients had significantly lower hippocampal volumes (Cohen’s d=−0.14, \% difference=−1.24). This effect was driven by patients with recurrent MDD (Cohen’s d=−0.17, \% difference=−1.44), and we detected no differences between first episode patients and controls. Age of onset ⩽21 was associated with a smaller hippocampus (Cohen’s d=−0.20, \% difference=−1.85) and a trend toward smaller amygdala (Cohen’s d=−0.11, \% difference=−1.23) and larger lateral ventricles (Cohen’s d=0.12, \% difference=5.11). Symptom severity at study inclusion was not associated with any regional brain volumes. Sample characteristics such as mean age, proportion of antidepressant users and proportion of remitted patients, and methodological characteristics did not significantly moderate alterations in brain volumes in MDD. Samples with a higher proportion of antipsychotic medication users showed larger caudate volumes in MDD patients compared with controls. This currently largest worldwide effort to identify subcortical brain alterations showed robust smaller hippocampal volumes in MDD patients, moderated by age of onset and first episode versus recurrent episode status.},
	language = {en},
	number = {6},
	urldate = {2026-01-29},
	journal = {Molecular Psychiatry},
	publisher = {Nature Publishing Group},
	author = {Schmaal, Lianne and Veltman, Dick J. and van Erp, Theo G. M. and Sämann, Philipp G. and Frodl, Thomas and Jahanshad, Neda and Loehrer, E. and Tiemeier, H. and Hofman, Albert and Niessen, Wiro J. and Vernooij, Meike W. and Ikram, M. Arfan and Wittfeld, K. and Grabe, H. J. and Block, A. and Hegenscheid, K. and Völzke, H. and Hoehn, D. and Czisch, M. and Lagopoulos, Jim and Hatton, Sean N. and Hickie, Ian B. and Goya-Maldonado, R. and Krämer, B. and Gruber, Oliver and Couvy-Duchesne, B. and Rentería, M. E. and Strike, L. T. and Mills, N. T. and de Zubicaray, Greig I. and McMahon, Katie L. and Medland, Sarah E. and Martin, Nicholas G. and Gillespie, N. A. and Wright, Margaret J. and Hall, G. B. and MacQueen, Glenda M. and Frey, E. M. and Carballedo, A. and van Velzen, Laura S. and van Tol, M. J. and van der Wee, N. J. and Veer, I. M. and Walter, Henrik and Schnell, K. and Schramm, E. and Normann, C. and Schoepf, D. and Konrad, C. and Zurowski, B. and Nickson, T. and McIntosh, Andrew M. and Papmeyer, M. and Whalley, Heather C. and Sussmann, J. E. and Godlewska, B. R. and Cowen, P. J. and Fischer, F. H. and Rose, M. and Penninx, B. W. J. H. and Thompson, Paul M. and Hibar, D. P.},
	month = jun,
	year = {2016},
	keywords = {Neuroscience},
	pages = {806--812},
	file = {Full Text PDF:/Users/soffiafdz/Zotero/storage/6YZEUXQE/Schmaal et al. - 2016 - Subcortical brain alterations in major depressive disorder findings from the ENIGMA Major Depressiv.pdf:application/pdf},
}

