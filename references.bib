	keywords = {Hippocampus segmentation, Cross entropy, Side U-Net architecture},
	pages = {143--150},
	file = {Yao et al_2019_Hippocampus Segmentation in MRI Using Side U-Net Model.pdf:/Users/soffiafdz/Zotero/storage/Z5BEDMRP/Yao et al_2019_Hippocampus Segmentation in MRI Using Side U-Net Model.pdf:application/pdf},
