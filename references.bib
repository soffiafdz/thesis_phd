	abstract = {Intracranial volume (ICV) normalization of regional brain volumes (v) is common practice in volumetric studies of the aging brain. Multiple normalization methods exist and this study aimed to investigate when each method is appropriate to use in gender dimorphism studies and how differences in v are affected by the choice of method. A new method based on weighted ICV matching is also presented. Theoretical reasoning and simulated experiments were followed by an evaluation using real data comprising 400 subjects, all 75 years old, whose ICV was segmented with a gold standard method. The presented method allows good visualization of volume relation between gender groups. A different gender dimorphism in volume was found depending on the normalization method used for both simulated and real data. Method performance was also seen to depend on the slope (B) and intercept (m) from the linear relation between v and ICV (v=B·ICV+m) as well as gender distribution in the cohort. A suggested work-flow for selecting ICV normalization method when investigating gender related differences in regional brain volume is presented.},
	number = {3},
	urldate = {2026-01-29},
	journal = {Psychiatry Research: Neuroimaging},
	author = {Nordenskjöld, Richard and Malmberg, Filip and Larsson, Elna-Marie and Simmons, Andrew and Ahlström, Håkan and Johansson, Lars and Kullberg, Joel},
	month = mar,
	year = {2015},
	keywords = {Dimorphism, Human brain, Intracranial volume, Normalization, Sex difference, Volume},
	pages = {227--235},
	file = {ScienceDirect Full Text PDF:/Users/soffiafdz/Zotero/storage/4BPP2I6K/Nordenskjöld et al. - 2015 - Intracranial volume normalization methods Considerations when investigating gender differences in r.pdf:application/pdf;ScienceDirect Snapshot:/Users/soffiafdz/Zotero/storage/A6MY2FPA/S0925492714003084.html:text/html},
}

@article{tarasoff-conway_clearance_2015,
	title = {Clearance systems in the brain—implications for {Alzheimer} disease},
